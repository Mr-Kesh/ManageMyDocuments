@page
@model Document_Management_System.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-primary" asp-page="/Admin/Users/Create">Create user</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input asp-for="Search" class="form-control" placeholder="Search by name" />
    </div>
    <div class="col-md-4">
        <select asp-for="Role" class="form-select">
            <option value="">All roles</option>
            <option value="Admin">Admin</option>
            <option value="User">User</option>
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-light me-2">Filter</button>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Users/Index">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.UserRole</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-light" asp-page="/Admin/Users/Edit" asp-route-id="@user.UserId">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-userId="@user.UserId" class="d-inline"
                              onsubmit="if (!confirm('Delete this user and related data?')) { event.preventDefault(); return false; }">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
