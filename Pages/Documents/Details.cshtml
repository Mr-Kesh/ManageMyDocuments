@page "{id:int}"
@model Document_Management_System.Pages.Documents.DetailsModel
@{
    ViewData["Title"] = Model.Document?.Title ?? "Document";
}

@if (Model.Document is null)
{
    <p>Document not found.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">@Model.Document.Title</h1>
            <p class="text-muted mb-0">Crew: @Model.Document.CrewName · Created @Model.Document.CreationTime.ToString("g")</p>
        </div>
        <div>
            <a class="btn btn-primary" asp-page="/Versions/Create" asp-route-documentId="@Model.Document.DocumentId">Add version</a>
            <a class="btn btn-outline-light" asp-page="/Documents/Edit" asp-route-id="@Model.Document.DocumentId">Edit</a>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Document.DocumentId" class="d-inline"
                  onsubmit="return confirm('Delete this document and all versions?');">
                <button type="submit" class="btn btn-outline-danger">Delete</button>
            </form>
        </div>
    </div>

    <h2 class="h5 mb-3">Versions</h2>
    @if (Model.Versions.Count == 0)
    {
        <p class="text-muted">No versions yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Version</th>
                        <th>Expires</th>
                        <th>Last Modified Time</th>
                        <th>Last Modified By</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var version in Model.Versions)
                    {
                        <tr>
                            <td>Version @version.VersionNumber.ToString()</td>
                            <td>@version.ExpirationDate.ToString("d")</td>
                            <td>@version.LastModifiedTime.ToString("g")</td>
                            <td>@version.LastModifiedByName</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-light" asp-page="/Versions/Details" asp-route-id="@version.VersionId">Open</a>
                                <a class="btn btn-sm btn-outline-light" asp-page="/Versions/Edit" asp-route-id="@version.VersionId">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a class="btn btn-outline-secondary mt-3" asp-page="/Documents/Index">Back to documents</a>
}
