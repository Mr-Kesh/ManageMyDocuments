@page "{id:int}"
@model Document_Management_System.Pages.Documents.EditModel
@{
    ViewData["Title"] = "Edit Document";
}

<h1 class="h3 mb-4">@ViewData["Title"]</h1>

<form method="post" class="card shadow-sm col-lg-7">
    <div class="card-body">
        <input type="hidden" asp-for="Input.DocumentId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.CrewName" class="form-label"></label>
            <input asp-for="Input.CrewName" class="form-control" />
            <span asp-validation-for="Input.CrewName" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary ms-2" asp-page="/Documents/Details" asp-route-id="@Model.Input.DocumentId">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
