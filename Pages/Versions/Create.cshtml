@page
@model Document_Management_System.Pages.Versions.CreateModel
@{
    ViewData["Title"] = "Add Version";
}

<h1 class="h3 mb-2">@ViewData["Title"]</h1>
<p class="text-muted mb-4">@Model.DocumentTitle — Next Version: <strong> @Model.NextVersionNumber.ToString() </strong></p>

<form method="post" enctype="multipart/form-data" class="card shadow-sm col-lg-7">
    <div class="card-body">
        <input type="hidden" asp-for="DocumentId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Input.ExpirationDate" class="form-label"></label>
            <input asp-for="Input.ExpirationDate" class="form-control" type="date" />
            <span asp-validation-for="Input.ExpirationDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Files" class="form-label"></label>
            <input asp-for="Input.Files" class="form-control" type="file" multiple />
            <span asp-validation-for="Input.Files" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create version</button>
        <a class="btn btn-outline-secondary ms-2" asp-page="/Documents/Details" asp-route-id="@Model.DocumentId">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
