@page "{id:int}"
@model Document_Management_System.Pages.Versions.DetailsModel
@{
    ViewData["Title"] = Model.Document is null ? "Version" : $"{Model.Document.Title} v{Model.Version?.VersionNumber}";
}

@if (Model.Version is null || Model.Document is null)
{
    <p>Version not found.</p>
}
else
{
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">@Model.Document.Title — Version @Model.Version.VersionNumber.ToString()</h1>
            <p class="text-muted mb-0">
                Expires @Model.Version.ExpirationDate.ToString("d") ·
                @Model.AttachmentCount file(s)
            </p>
        </div>
        <div>

            @if (Model.IsAdminUser || Model.Version.LastModifiedBy == Model.CurrentUserIdValue)
            {
                <a class="btn btn-outline-light" asp-page="/Versions/Edit" asp-route-id="@Model.Version.VersionId">Edit expiry</a>
                <form method="post" asp-page-handler="DeleteVersion" asp-route-id="@Model.Version.VersionId" class="d-inline"
                      onsubmit="return confirm('Delete this version and its files?');">
                    <button type="submit" class="btn btn-outline-danger">Delete version</button>
                </form>
            }
        </div>
    </div>

    <h2 class="h5 mb-3">Attachments</h2>
    @if (Model.Attachments.Count == 0)
    {
        <p class="text-muted">No files attached.</p>
    }
    else
    {
        <ul class="list-group mb-4">
            @foreach (var file in Model.Attachments)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@file.AttachmentName <small class="text-muted">(@file.AttachmentType)</small></span>
                    <span>
                        <a class="btn btn-sm btn-outline-light" asp-page="/Attachments/Download" asp-route-id="@file.AttachmentId">Download</a>
                        <a class="btn btn-sm btn-outline-info" asp-page="/Attachments/Open" asp-route-id="@file.AttachmentId" target="_blank">Open</a>

                        @if (Model.IsAdminUser || Model.Version.LastModifiedBy == Model.CurrentUserIdValue)
                        {
                            <form method="post" asp-page-handler="DeleteAttachment" asp-route-id="@Model.Version.VersionId" asp-route-attachmentId="@file.AttachmentId" class="d-inline"
                              onsubmit="return confirm('Delete this file?');">
                                <button type="submit" class="btn btn-outline-danger">Delete</button>
                            </form>
                        }
                    </span>
                </li>
            }
        </ul>
    }

    <form method="post" asp-page-handler="Upload" asp-route-id="@Model.Version.VersionId" enctype="multipart/form-data" class="card shadow-sm col-lg-7 mb-4">
        <div class="card-body">
            <h3 class="h6">Add files</h3>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input asp-for="UploadFiles" class="form-control mb-3" type="file" multiple />
            <button type="submit" class="btn btn-primary">Upload</button>
        </div>
    </form>

    <a class="btn btn-outline-secondary" asp-page="/Documents/Details" asp-route-id="@Model.Document.DocumentId">Back to document</a>
}